# Copy to .env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=changeme-dev-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Postgres + pgvector) ---
DB_NAME=rag_catalog
DB_USER=rag_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5433

# --- Redis (Celery broker/result backend) — added in Phase 2 ---
REDIS_URL=redis://localhost:6379/0

# --- Embeddings provider — added in Phase 2 ---
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# --- LLM provider — added in Phase 4/5 ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
