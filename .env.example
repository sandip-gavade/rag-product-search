# Copy to .env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=changeme-dev-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Postgres + pgvector) ---
DB_NAME=rag_catalog
DB_USER=rag_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5433

# --- Redis (Celery broker/result backend) ---
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- Embeddings provider — added in Phase 2 ---
# openai = text-embedding-3-small (paid, 1536-dim). lmstudio = free local
# embeddings (nomic-embed-text-v1.5, 768-dim) — see "Choosing an embeddings
# provider" in the README. The two are NOT interchangeable without a
# migration: EMBEDDING_DIMENSIONS in catalog/models.py must match whichever
# you pick.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# --- LLM provider — added in Phase 4/5 ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
# LLM_PROVIDER=lmstudio uses these instead (LM Studio's OpenAI-compatible local server).
# Prefer a non-reasoning model — see "Choosing an LLM provider" in the README.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-7b-instruct

# --- CORS (React dev server) — added in Phase 6 ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
